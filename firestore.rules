rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPublicIdentity(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/identity/profile)
        .data.isPublic == true;
    }

    function membershipDocId(gymId, userId, membershipType) {
      return gymId + '_' + userId + '_' + membershipType;
    }

    function ownsMembershipDoc(membershipId) {
      return request.auth != null
        && membershipId.matches('.*_' + request.auth.uid + '_(athlete|coach|manager)$');
    }

    function isApprovedAthleteAtGym(gymId) {
      let id = membershipDocId(gymId, request.auth.uid, 'athlete');
      return exists(/databases/$(database)/documents/gymMemberships/$(id))
        && get(/databases/$(database)/documents/gymMemberships/$(id)).data.status == 'approved';
    }

    function isApprovedCoachAtGym(gymId) {
      return isApprovedCoachAtGymForUser(gymId, request.auth.uid);
    }

    function isApprovedCoachAtGymForUser(gymId, userId) {
      let id = membershipDocId(gymId, userId, 'coach');
      return exists(/databases/$(database)/documents/gymMemberships/$(id))
        && get(/databases/$(database)/documents/gymMemberships/$(id)).data.status == 'approved';
    }

    function canReadGymMembership(membershipId) {
      return request.auth != null && (
        resource.data.userId == request.auth.uid
        || ownsMembershipDoc(membershipId)
        || (resource.data.gymId is string && canManageGym(resource.data.gymId))
        || (resource.data.gymId is string
          && isApprovedAthleteAtGym(resource.data.gymId))
      );
    }

    function athleteMarksVerificationStackResynced() {
      return request.auth != null
        && resource.data.athleteId == request.auth.uid
        && resource.data.stackResynced != true
        && request.resource.data.stackResynced == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stackResynced']);
    }

    function coachAssignedToAthleteProof(athleteId, proofId) {
      return request.auth != null
        && proofId is string
        && proofId.size() > 0
        && exists(/databases/$(database)/documents/users/$(athleteId)/proofs/$(proofId))
        && get(/databases/$(database)/documents/users/$(athleteId)/proofs/$(proofId)).data.coachId == request.auth.uid;
    }

    function isAssignedCoachOnProof() {
      return request.auth != null && (
        resource.data.coachId == request.auth.uid
        || resource.data.verifiedByCoachId == request.auth.uid
        || resource.data.requestedCoachId == request.auth.uid
      );
    }

    // Coach account deletion: keep historical verification, clear live coach UIDs.
    function coachAnonymizesAssignedProof() {
      return isAssignedCoachOnProof()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.skillId == resource.data.skillId
        && request.resource.data.coachAccountDeleted == true
        && request.resource.data.coachId == null
        && request.resource.data.verifiedByCoachId == null
        && request.resource.data.requestedCoachId == null
        && (
          request.resource.data.verificationStatus == resource.data.verificationStatus
          || (
            resource.data.verificationStatus == 'pending_verification'
            && request.resource.data.verificationStatus == 'self_reported'
          )
          || (
            resource.data.proofSource == 'coach'
            && resource.data.verificationStatus != 'pending_verification'
            && resource.data.verificationStatus != 'rejected'
            && resource.data.verificationStatus != 'declined'
            && request.resource.data.verificationStatus == 'coach_verified'
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'coachId',
            'requestedCoachId',
            'verifiedByCoachId',
            'coachAccountDeleted',
            'verificationStatus',
            'proofSource'
          ]);
    }

    function isReportSubjectAnonymization() {
      return request.auth != null
        && resource.data.reportedUserId == request.auth.uid
        && request.resource.data.reporterUserId == resource.data.reporterUserId
        && request.resource.data.reportedUserId == resource.data.reportedUserId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.details == resource.data.details
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reportedHandle == '[deleted]'
        && request.resource.data.reportedAccountDeleted == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reportedHandle', 'reportedAccountDeleted']);
    }

    function isGymManager(gymId) {
      let id = membershipDocId(gymId, request.auth.uid, 'manager');
      return exists(/databases/$(database)/documents/gymMemberships/$(id))
        && get(/databases/$(database)/documents/gymMemberships/$(id)).data.status == 'approved';
    }

    function isApprovedGymMember(gymId) {
      return isApprovedAthleteAtGym(gymId)
        || isApprovedCoachAtGym(gymId)
        || isGymManager(gymId);
    }

    function activityPath(gymId, activityId) {
      return /databases/$(database)/documents/gyms/$(gymId)/activity/$(activityId);
    }

    function sharedActivityOpen(gymId, activityId) {
      return exists(activityPath(gymId, activityId))
        && get(activityPath(gymId, activityId)).data.status == 'active'
        && get(activityPath(gymId, activityId)).data.gymId == gymId;
    }

    function proofPath(athleteId, proofId) {
      return /databases/$(database)/documents/users/$(athleteId)/proofs/$(proofId);
    }

    function likeCountChangeIsValid(gymId, activityId) {
      let likePath = /databases/$(database)/documents/gyms/$(gymId)/activity/$(activityId)/likes/$(request.auth.uid);
      let before = resource.data.likeCount;
      let after = request.resource.data.likeCount;
      let added = !exists(likePath) && existsAfter(likePath);
      let removed = exists(likePath) && !existsAfter(likePath);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && resource.data.athleteId != request.auth.uid
        && resource.data.status == 'active'
        && (
          (added
            && after == before + 1
            && getAfter(likePath).data.userId == request.auth.uid)
          || (removed && before > 0 && after == before - 1)
        );
    }

    function commentCountChangeIsValid(gymId, activityId) {
      let id = request.resource.data.lastCommentId;
      let commentPath = /databases/$(database)/documents/gyms/$(gymId)/activity/$(activityId)/comments/$(id);
      let added = !exists(commentPath) && existsAfter(commentPath);
      let removed = exists(commentPath) && !existsAfter(commentPath);
      return id is string
        && id.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['commentCount', 'lastCommentId'])
        && resource.data.athleteId != request.auth.uid
        && resource.data.status == 'active'
        && (
          (added
            && request.resource.data.commentCount == resource.data.commentCount + 1
            && getAfter(commentPath).data.authorId == request.auth.uid)
          || (removed
            && resource.data.commentCount > 0
            && request.resource.data.commentCount == resource.data.commentCount - 1
            && get(commentPath).data.authorId == request.auth.uid)
        );
    }

    function verificationRefreshIsValid() {
      let proof = proofPath(resource.data.athleteId, resource.data.proofId);
      return exists(proof)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['verificationStatus'])
        && request.resource.data.verificationStatus is string
        && request.resource.data.verificationStatus == get(proof).data.verificationStatus;
    }

    function isGymCreator(gymId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/gyms/$(gymId))
        && get(/databases/$(database)/documents/gyms/$(gymId)).data.createdBy == request.auth.uid;
    }

    function canManageGym(gymId) {
      return isGymManager(gymId) || isGymCreator(gymId);
    }

    function isPendingMembershipRequest() {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.gymId is string
        && request.resource.data.gymId.size() > 0
        && request.resource.data.membershipType in ['athlete', 'coach'];
    }

    function isReMembershipRequest(membershipId) {
      return request.auth != null
        && ownsMembershipDoc(membershipId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && resource.data.status in ['removed', 'rejected', 'suspended'];
    }

    function isManagerBootstrap(membershipId) {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.membershipType == 'manager'
        && request.resource.data.status == 'approved'
        && request.resource.data.gymId is string
        && request.resource.data.gymId.size() > 0
        && membershipId == membershipDocId(
          request.resource.data.gymId, request.auth.uid, 'manager'
        )
        && isGymCreator(request.resource.data.gymId);
    }

    function isRelationshipParticipant() {
      return request.auth != null && (
        resource.data.fromUserId == request.auth.uid
        || resource.data.toUserId == request.auth.uid
        || resource.data.requesterUserId == request.auth.uid
        || resource.data.recipientUserId == request.auth.uid
      );
    }

    function relationshipCoreFieldsImmutable() {
      return request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.type == resource.data.type;
    }

    function allowedFriendTransition() {
      return relationshipCoreFieldsImmutable()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'respondedAt', 'requesterSeen', 'recipientSeen',
          'blockedByUserId'
        ])
        && (
          (resource.data.status == 'pending'
            && ((resource.data.toUserId == request.auth.uid
                && request.resource.data.status in ['accepted', 'declined'])
              || (resource.data.fromUserId == request.auth.uid
                && request.resource.data.status == 'declined')
              || (request.resource.data.status == 'blocked'
                && request.resource.data.blockedByUserId == request.auth.uid)))
          || (resource.data.status == 'accepted'
            && request.resource.data.status == 'blocked'
            && request.resource.data.blockedByUserId == request.auth.uid)
          || (resource.data.status == 'blocked'
            && resource.data.blockedByUserId == request.auth.uid
            && request.resource.data.status == 'declined')
        );
    }

    function managerCancelsPendingVerification() {
      return canManageGym(resource.data.gymId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy']);
    }

    function managerRevertsPendingProof() {
      return resource.data.verificationStatus == 'pending_verification'
        && request.resource.data.verificationStatus == 'self_reported'
        && resource.data.verificationGymId is string
        && canManageGym(resource.data.verificationGymId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'verificationStatus',
            'proofSource',
            'verifiedAt',
            'verifiedByCoachId',
            'coachId',
            'requestedCoachId'
          ]);
    }

    function isAllowedRoleChange() {
      return request.resource.data.accountType == resource.data.accountType
        && request.resource.data.managedGymIds == resource.data.managedGymIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'specialty', 'updatedAt'])
        && (
          (resource.data.role == 'athlete'
            && request.resource.data.role == 'athlete_and_coach')
          || (resource.data.role == 'athlete_and_coach'
            && request.resource.data.role == 'athlete')
        );
    }

    function friendDocId(userA, userB) {
      return userA < userB
        ? 'friend_' + userA + '_' + userB
        : 'friend_' + userB + '_' + userA;
    }

    function isAcceptedFriend(otherUserId) {
      let id = friendDocId(request.auth.uid, otherUserId);
      return exists(/databases/$(database)/documents/relationships/$(id))
        && get(/databases/$(database)/documents/relationships/$(id)).data.type == 'friend'
        && get(/databases/$(database)/documents/relationships/$(id)).data.status == 'accepted';
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && (
        (request.resource.data.role == resource.data.role
          && request.resource.data.managedGymIds == resource.data.managedGymIds
          && request.resource.data.accountType == resource.data.accountType)
        || resource.data.onboardingCompleted != true
        || isAllowedRoleChange()
      );
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /identity/{docId} {
        allow read: if isPublicIdentity(userId)
          || (request.auth != null && request.auth.uid == userId)
          || (request.auth != null && isAcceptedFriend(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /skills/{skillId} {
        allow read: if isPublicIdentity(userId)
          || (request.auth != null && request.auth.uid == userId)
          || (request.auth != null && isAcceptedFriend(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /proofs/{proofId} {
        allow read: if isPublicIdentity(userId)
          || (request.auth != null && request.auth.uid == userId)
          || isAssignedCoachOnProof();
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && (
          request.auth.uid == userId
          || (resource.data.coachId == request.auth.uid
            && request.resource.data.coachId == request.auth.uid)
          || coachAnonymizesAssignedProof()
          || managerRevertsPendingProof()
        );
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /timeline/{eventId} {
        allow read: if isPublicIdentity(userId)
          || (request.auth != null && request.auth.uid == userId);
        allow create: if request.auth != null && (
          request.auth.uid == userId
          || (request.resource.data.type == 'coach_verified'
            && request.resource.data.referenceId is string
            && coachAssignedToAthleteProof(userId, request.resource.data.referenceId))
        );
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Experience receipts — owner-only; no private proof body content.
      // Read is path-scoped to the authenticated owner so get-on-missing
      // (claim transactions / eligibility) and status queries succeed.
      match /experienceReceipts/{eventId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.keys().hasAll([
            'ownerId',
            'eventType',
            'sourceId',
            'importance',
            'status',
            'createdAt',
            'schemaVersion'
          ])
          && request.resource.data.status in [
            'pending',
            'presenting',
            'completed',
            'dismissed',
            'failed'
          ];
        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.ownerId == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.status in [
            'pending',
            'presenting',
            'completed',
            'dismissed',
            'failed'
          ];
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && resource.data.ownerId == userId;
      }
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /gymHandles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.gymId is string
        && request.resource.data.gymId.size() > 0
        && exists(/databases/$(database)/documents/gyms/$(request.resource.data.gymId))
        && get(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.gymId is string
        && get(/databases/$(database)/documents/gyms/$(resource.data.gymId)).data.createdBy == request.auth.uid;
    }

    match /gyms/{gymId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && canManageGym(gymId);
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /activity/{activityId} {
        allow read: if isApprovedGymMember(gymId)
          && resource.data.status == 'active';

        allow create: if isApprovedAthleteAtGym(gymId)
          && activityId == request.resource.data.proofId
          && request.resource.data.gymId == gymId
          && request.resource.data.athleteId == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.likeCount == 0
          && request.resource.data.commentCount == 0
          && request.resource.data.lastCommentId == ''
          && request.resource.data.sharedAt == request.time
          && request.resource.data.keys().hasOnly([
            'gymId', 'athleteId', 'proofId', 'skillId', 'skillName',
            'discipline', 'variantName', 'result', 'unit', 'recordedAt',
            'verificationStatus', 'displayName', 'avatarUrl', 'status',
            'likeCount', 'commentCount', 'sharedAt', 'lastCommentId'
          ])
          && exists(proofPath(request.auth.uid, activityId))
          && getAfter(proofPath(request.auth.uid, activityId)).data.userId == request.auth.uid
          && getAfter(proofPath(request.auth.uid, activityId)).data.sharedWithGymId == gymId
          && getAfter(proofPath(request.auth.uid, activityId)).data.skillId == request.resource.data.skillId
          && getAfter(proofPath(request.auth.uid, activityId)).data.result == request.resource.data.result
          && getAfter(proofPath(request.auth.uid, activityId)).data.unit == request.resource.data.unit
          && getAfter(proofPath(request.auth.uid, activityId)).data.recordedAt == request.resource.data.recordedAt
          && getAfter(proofPath(request.auth.uid, activityId)).data.verificationStatus == request.resource.data.verificationStatus
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/skills/$(request.resource.data.skillId))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/skills/$(request.resource.data.skillId)).data.name == request.resource.data.skillName
          && request.resource.data.discipline == (
            get(/databases/$(database)/documents/users/$(request.auth.uid)/skills/$(request.resource.data.skillId)).data.discipline is string
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)/skills/$(request.resource.data.skillId)).data.discipline
              : ''
          )
          && request.resource.data.variantName == (
            getAfter(proofPath(request.auth.uid, activityId)).data.variantName == null
              ? ''
              : getAfter(proofPath(request.auth.uid, activityId)).data.variantName
          )
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/identity/profile)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/identity/profile).data.displayName == request.resource.data.displayName
          && request.resource.data.avatarUrl == (
            get(/databases/$(database)/documents/users/$(request.auth.uid)/identity/profile).data.avatarUrl is string
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)/identity/profile).data.avatarUrl
              : ''
          );

        allow update: if isApprovedGymMember(gymId) && (
          likeCountChangeIsValid(gymId, activityId)
          || commentCountChangeIsValid(gymId, activityId)
          || verificationRefreshIsValid()
        );

        allow delete: if resource.data.athleteId == request.auth.uid
          || canManageGym(gymId);

        match /likes/{userId} {
          allow read: if request.auth.uid == userId
            || (isApprovedGymMember(gymId) && sharedActivityOpen(gymId, activityId));
          allow create: if isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId)
            && userId == request.auth.uid
            && get(activityPath(gymId, activityId)).data.athleteId != request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && getAfter(activityPath(gymId, activityId)).data.likeCount
              == get(activityPath(gymId, activityId)).data.likeCount + 1;
          allow update: if false;
          allow delete: if (
            request.auth.uid == userId
            && isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId)
            && getAfter(activityPath(gymId, activityId)).data.likeCount
              == get(activityPath(gymId, activityId)).data.likeCount - 1
          ) || (
            !existsAfter(activityPath(gymId, activityId))
            && (
              get(activityPath(gymId, activityId)).data.athleteId == request.auth.uid
              || canManageGym(gymId)
            )
          );
        }

        match /comments/{commentId} {
          allow read: if isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId);
          allow create: if isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId)
            && get(activityPath(gymId, activityId)).data.athleteId != request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 300
            && request.resource.data.text.matches('.*\\S.*')
            && request.resource.data.createdAt == request.time
            && request.resource.data.displayName is string
            && request.resource.data.avatarUrl is string
            && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)/identity/profile).data.displayName
            && request.resource.data.keys().hasOnly([
              'authorId', 'text', 'displayName', 'avatarUrl', 'createdAt'
            ])
            && existsAfter(/databases/$(database)/documents/gyms/$(gymId)/activity/$(activityId)/commentRate/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/gyms/$(gymId)/activity/$(activityId)/commentRate/$(request.auth.uid)).data.lastAt == request.time
            && getAfter(activityPath(gymId, activityId)).data.commentCount
              == get(activityPath(gymId, activityId)).data.commentCount + 1
            && getAfter(activityPath(gymId, activityId)).data.lastCommentId == commentId;
          allow update: if false;
          allow delete: if (
            resource.data.authorId == request.auth.uid
            && isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId)
            && getAfter(activityPath(gymId, activityId)).data.commentCount
              == get(activityPath(gymId, activityId)).data.commentCount - 1
            && getAfter(activityPath(gymId, activityId)).data.lastCommentId == commentId
          ) || (
            !existsAfter(activityPath(gymId, activityId))
            && (
              get(activityPath(gymId, activityId)).data.athleteId == request.auth.uid
              || canManageGym(gymId)
            )
          );
        }

        match /commentRate/{userId} {
          allow read: if isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId);
          allow create: if userId == request.auth.uid
            && isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId)
            && !exists(/databases/$(database)/documents/gyms/$(gymId)/activity/$(activityId)/commentRate/$(userId))
            && request.resource.data.userId == userId
            && request.resource.data.lastAt == request.time
            && request.resource.data.keys().hasOnly(['userId', 'lastAt']);
          allow update: if userId == request.auth.uid
            && isApprovedGymMember(gymId)
            && sharedActivityOpen(gymId, activityId)
            && resource.data.lastAt < request.time - duration.value(15, 's')
            && request.resource.data.userId == userId
            && request.resource.data.lastAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt']);
          allow delete: if !existsAfter(activityPath(gymId, activityId))
            && (
              get(activityPath(gymId, activityId)).data.athleteId == request.auth.uid
              || canManageGym(gymId)
            );
        }
      }
    }

    match /gymMemberships/{membershipId} {
      allow read: if canReadGymMembership(membershipId);
      allow create: if request.auth != null && (
        (ownsMembershipDoc(membershipId) && isPendingMembershipRequest())
        || (ownsMembershipDoc(membershipId) && isManagerBootstrap(membershipId))
      );
      allow update: if request.auth != null && (
        (resource.data.gymId is string && canManageGym(resource.data.gymId))
        || (ownsMembershipDoc(membershipId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'removed')
        || isReMembershipRequest(membershipId)
        || (ownsMembershipDoc(membershipId) && isPendingMembershipRequest())
      );
      // Own membership, or gym creator closing the gym during account deletion.
      allow delete: if request.auth != null && (
        ownsMembershipDoc(membershipId)
        || (resource.data.gymId is string && isGymCreator(resource.data.gymId))
      );
    }

    match /relationships/{relationshipId} {
      // Back-compat: some legacy relationship docs used requesterUserId/recipientUserId
      // instead of fromUserId/toUserId.
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid
        || resource.data.toUserId == request.auth.uid
        || resource.data.requesterUserId == request.auth.uid
        || resource.data.recipientUserId == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && (
          (request.resource.data.type == 'friend'
            && request.resource.data.status == 'pending')
          || (request.resource.data.type == 'coach'
            && request.resource.data.status == 'pending')
          || (request.resource.data.type == 'friend'
            && request.resource.data.status == 'blocked'
            && request.resource.data.blockedByUserId == request.auth.uid)
        );
      allow update: if request.auth != null
        && isRelationshipParticipant()
        && (
          (resource.data.type == 'friend' && allowedFriendTransition())
          || (resource.data.type != 'friend' && relationshipCoreFieldsImmutable())
        );
      allow delete: if request.auth != null && (
        (resource.data.status == 'blocked'
          && resource.data.blockedByUserId == request.auth.uid)
        || (resource.data.status == 'pending'
          && resource.data.fromUserId == request.auth.uid)
        || (resource.data.status == 'accepted' && isRelationshipParticipant())
      );
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /verificationRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.athleteId == request.auth.uid
        || resource.data.coachId == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.athleteId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.gymId is string
        && request.resource.data.coachId is string
        && isApprovedAthleteAtGym(request.resource.data.gymId)
        && isApprovedCoachAtGymForUser(
          request.resource.data.gymId,
          request.resource.data.coachId
        );
      allow update: if request.auth != null && (
        (
          resource.data.coachId == request.auth.uid
          && resource.data.status == 'pending'
          && isApprovedCoachAtGym(resource.data.gymId)
        )
        || athleteMarksVerificationStackResynced()
        || managerCancelsPendingVerification()
      );
      // Account deletion: athlete or assigned coach may remove their requests.
      allow delete: if request.auth != null && (
        resource.data.athleteId == request.auth.uid
        || resource.data.coachId == request.auth.uid
      );
    }

    match /coachProfiles/{userId} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /userReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow read: if request.auth != null
        && resource.data.reporterUserId == request.auth.uid;
      // Reported user may only anonymize their handle on account deletion.
      allow update: if isReportSubjectAnonymization();
      // Account deletion: only the reporter may delete their own submissions.
      // Reports about a user are retained (anonymized) for moderation.
      allow delete: if request.auth != null
        && resource.data.reporterUserId == request.auth.uid;
    }
  }
}
